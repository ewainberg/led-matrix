# Weather
WEATHER_KEY=your_weather_api_key
WEATHER_BASE_URL=http://api.weatherapi.com/v1
WEATHER_LOCATION=Orlando

# APIs
BUS_URL=https://ucf.transloc.com/Services/JSONPRelay.svc/GetStopArrivalTimes?apiKey=&stopIds=60&version=2
EXCUSES_URL=https://excuses.onrender.com/excuse
MESSAGE_URL=https://example.com/matrix-message/message.txt
NEXT_URL=https://example.com/matrix-message/next.php?key=REPLACE_ME

# Timezone
TZ=America/New_York

# Fetch timing (seconds)
FETCH_INTERVAL_S=30

# Matrix geometry
MATRIX_WIDTH_PX=160
MATRIX_HEIGHT_PX=8
TEXT_AREA_WIDTH_PX=128
CLOCK_START_X_PX=128

# Scroll behavior
SCROLL_START_PAUSE_S=1.0
SCROLL_GAP_PX=12
SCROLL_SPEED_PX_S=60.0
SCROLL_PASSES_MIN=2
